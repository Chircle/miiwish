rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }
  }
}
