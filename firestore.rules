rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Es gibt keine Cloud Function, die einen Custom Claim (admin:true)
    // setzt — deshalb prüfen wir stattdessen eine feste Liste von
    // Admin-UIDs. UID findest du in der Firebase Console unter
    // Authentication -> Users -> Spalte "User UID" für deinen
    // Admin-Account (den mit E-Mail/Passwort-Login).
    function isAdmin() {
      return isSignedIn() && request.auth.uid in [
        'HIER_DEINE_ADMIN_UID_EINTRAGEN'
        // ggf. weitere Admin-UIDs mit Komma getrennt ergänzen
      ];
    }

    // Es wurden nur genau diese Felder verändert
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------------------------------------------------------------
    // items — die Wunschliste
    // ---------------------------------------------------------------
    match /items/{itemId} {

      // Für alle sichtbar (auch nicht eingeloggte Besucher sehen die
      // Struktur nicht direkt, da das Frontend die Gates davor setzt,
      // aber roh per API wäre es lesbar — siehe Hinweis unten).
      allow read: if true;

      allow create: if isAdmin();
      allow delete: if isAdmin();

      allow update: if isAdmin() || (
        isSignedIn() && (
          // Reservieren: Item war frei, wird jetzt von MIR reserviert.
          // toggleReserved() in script.js meldet den Nutzer dafür
          // automatisch anonym an (ensureRequestUserSignedIn()).
          (
            resource.data.reserved == false &&
            request.resource.data.reserved == true &&
            request.resource.data.reservedBy == request.auth.uid &&
            onlyChanged(['reserved', 'reservedBy'])
          )
          ||
          // Freigeben: nur die EIGENE Reservierung darf ich lösen
          (
            resource.data.reserved == true &&
            resource.data.reservedBy == request.auth.uid &&
            request.resource.data.reserved == false &&
            request.resource.data.reservedBy == null &&
            onlyChanged(['reserved', 'reservedBy'])
          )
        )
      );
    }

    // ---------------------------------------------------------------
    // requests — Zugriffsanfragen (Doc-ID == uid, so wie script.js es
    // tatsächlich anlegt: addRequest() meldet den Nutzer IMMER zuerst
    // anonym an und benutzt danach dessen uid als Doc-ID)
    // ---------------------------------------------------------------
    match /requests/{userId} {

      // Öffentlich lesbar, weil findExistingRequestForEmail() in
      // script.js eine where('email','==', …)-Query braucht, um den
      // Status-Check per E-Mail auf einem NEUEN Gerät (ohne vorheriges
      // Login) zu ermöglichen. Firestore-Rules können eine Query nicht
      // auf "nur mein eigenes Dokument" einschränken, wenn nach email
      // statt nach der Doc-ID gefiltert wird.
      // -> Name/E-Mail/Grund sind damit technisch für jeden mit
      // direktem Firestore-Zugriff lesbar (nicht nur über die UI).
      // Für echte Privatsphäre bräuchte es eine Cloud Function, die
      // serverseitig nur den Status zurückgibt. Sag Bescheid, wenn du
      // das willst, das baue ich dir gerne.
      allow read: if true;

      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.reason is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.ts is int;

      // Erneutes Einreichen nach Ablehnung: nur der eigene Account,
      // nur von 'declined' zurück auf 'pending'. Freigeben kann sich
      // niemand selbst.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        resource.data.status == 'declined' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.uid == userId
      );

      allow delete: if isAdmin();
    }
  }
}
