rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /items/{itemId} {
      allow read: if true;

      // admin-only item management
      allow create: if isAdmin();
      allow delete: if isAdmin();

      // admins can update anything; users can only change their own reservation state
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.reservedBy == request.auth.uid
          && request.resource.data.reserved == false
          && resource.data.reserved == true
        )
        || (
          isSignedIn()
          && request.resource.data.reserved == true
          && request.resource.data.reservedBy == request.auth.uid
          && resource.data.reserved == false
        );
    }

    match /requests/{userId} {
      allow read: if true;

      // user can only create their own request document
      allow create: if isSignedIn() && request.auth.uid == userId;

      // user can resubmit only after the previous request was declined
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && resource.data.status == 'declined')
        || isAdmin()
      );

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
